# --- App ---
ENVIRONMENT=development
DEBUG=true

# --- Data provider ---
# "none" = no live provider wired up yet (system degrades gracefully, never fabricates data)
# "sample-dev-only" = deterministic sample data for local dev/tests ONLY (never use in prod)
# "rest-generic" = production-ready generic REST adapter (app/providers/rest_football_provider.py) --
#                  requires FOOTBALL_DATA_API_KEY and FOOTBALL_DATA_API_BASE_URL below.
# DATA_PROVIDER is accepted as an alias for ACTIVE_PROVIDER (either name works; ACTIVE_PROVIDER wins
# if both are set).
ACTIVE_PROVIDER=none
# DATA_PROVIDER=rest-generic

FOOTBALL_DATA_API_KEY=
FOOTBALL_DATA_API_BASE_URL=
# Endpoint paths -- override per vendor, see app/providers/rest_football_provider.py
FOOTBALL_DATA_FIXTURES_PATH=/fixtures
FOOTBALL_DATA_TEAM_STATS_PATH=/teams/statistics
FOOTBALL_DATA_STANDINGS_PATH=/standings
FOOTBALL_DATA_H2H_PATH=/fixtures/headtohead
FOOTBALL_DATA_REQUEST_TIMEOUT_SECONDS=10.0
FOOTBALL_DATA_MAX_RETRIES=2

# Odds are always optional (see Market Cross-Check / Golden Rule) -- leave blank if unused.
ODDS_API_KEY=
ODDS_API_BASE_URL=
ODDS_API_PATH=/odds
ODDS_API_REQUEST_TIMEOUT_SECONDS=10.0

# --- Cache ---
CACHE_BACKEND=memory
CACHE_DEFAULT_TTL_SECONDS=900
TEAM_STRENGTH_CACHE_TTL_SECONDS=3600
MATCH_ANALYSIS_CACHE_TTL_SECONDS=1800

# --- Statistical modeling ---
POISSON_MAX_GOALS=10
DIXON_COLES_RHO=-0.13
MIN_MATCHES_FOR_RELIABLE_FORM=5
MIN_MATCHES_FOR_HIGH_CONFIDENCE=10

MODEL_WEIGHT_POISSON_DIXON_COLES=0.55
MODEL_WEIGHT_ELO_STRENGTH=0.30
MODEL_WEIGHT_FORM_BASED=0.15

# --- Sanity / Confidence ---
SANITY_MARKET_DISAGREEMENT_THRESHOLD=0.35
SANITY_MIN_CONFIDENCE_AFTER_CONTRADICTION=0.35
MAX_PUBLIC_CONFIDENCE_LABEL=0.90

# --- Chat / LLM (optional -- system works fully without this) ---
LLM_PROVIDER=none
LLM_API_KEY=
LLM_MODEL=claude-sonnet-4-6
CHAT_CONTEXT_MAX_TURNS=12

# --- Logging ---
LOG_LEVEL=INFO
LOG_JSON=false
